# Yahoo app: not used yet. Yahoo blocks Fantasy API access until the app is approved.
# Yahoo app (developer.yahoo.com/apps) - redirect URI must match the app's setting exactly
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
YAHOO_REDIRECT_URI=https://localhost:3000/
# The number in your league URL: basketball.fantasysports.yahoo.com/nba/<THIS>
YAHOO_LEAGUE_ID=

# From @BotFather, then run `python bot.py chatid`
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional
POLL_MINUTES=10
# ESPN statuses that trigger an alert. Use Out,Day-To-Day to include questionable players (noisier).
ALERT_STATUSES=Out
# Only alert on players at least this % owned in ESPN fantasy leagues (your MY_PLAYERS always alert)
MIN_OWNED=20
# Your Yahoo roster, comma separated, exactly as ESPN spells names. Flags alerts as yours.
MY_PLAYERS=
NEWS_UPDATES=true
ALERT_ON_RETURN=true
SUGGESTIONS=3
